-- ==========================================
-- 1. CREACIÓN DE TABLAS
-- ==========================================

-- Tabla de Partidas
CREATE TABLE IF NOT EXISTS public.partidas (
    id TEXT PRIMARY KEY,
    max_jugadores INT NOT NULL DEFAULT 2,
    dimension INT NOT NULL DEFAULT 3,
    en_raya_para_ganar INT NOT NULL DEFAULT 3,
    jugadores JSONB NOT NULL DEFAULT '[]'::jsonb,
    turno_index INT NOT NULL DEFAULT 0,
    tablero JSONB NOT NULL DEFAULT '[]'::jsonb,
    estado TEXT NOT NULL DEFAULT 'esperando',
    ganador TEXT DEFAULT NULL,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Tabla de Estadísticas de Jugadores (Ranking)
CREATE TABLE IF NOT EXISTS public.jugadores_stats (
    nombre TEXT PRIMARY KEY,
    ganadas INT NOT NULL DEFAULT 0,
    perdidas INT NOT NULL DEFAULT 0,
    empatadas INT NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT NOW()
);


-- ==========================================
-- 2. POLÍTICAS DE SEGURIDAD (RLS) Y PERMISOS
-- ==========================================

-- Activar RLS en ambas tablas
ALTER TABLE public.partidas ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.jugadores_stats ENABLE ROW LEVEL SECURITY;

-- Limpiar políticas anteriores para evitar duplicados
DROP POLICY IF EXISTS "Permitir acceso total público a partidas" ON public.partidas;
DROP POLICY IF EXISTS "Permitir acceso total público a ranking" ON public.jugadores_stats;

-- Crear políticas permisivas para lectura, inserción, actualización y borrado público
CREATE POLICY "Permitir acceso total público a partidas" 
ON public.partidas FOR ALL USING (true) WITH CHECK (true);

CREATE POLICY "Permitir acceso total público a ranking" 
ON public.jugadores_stats FOR ALL USING (true) WITH CHECK (true);

-- Asignar permisos explícitos al rol público (anon) y autenticado
GRANT ALL ON TABLE public.partidas TO anon, authenticated, service_role;
GRANT ALL ON TABLE public.jugadores_stats TO anon, authenticated, service_role;


-- ==========================================
-- 3. HABILITAR TIEMPO REAL (REALTIME)
-- ==========================================

DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_publication_tables 
    WHERE pubname = 'supabase_realtime' AND tablename = 'partidas'
  ) THEN
    ALTER PUBLICATION supabase_realtime ADD TABLE public.partidas;
  END IF;
END $$;


-- ==========================================
-- 4. FUNCIONES REMOTAS (RPC)
-- ==========================================

-- Función 1: Procesar jugadas y turnos de forma segura y atómica
CREATE OR REPLACE FUNCTION public.procesar_movimiento(
    p_partida_id TEXT,
    p_simbolo TEXT,
    p_casilla_index INT,
    p_nuevo_tablero JSONB,
    p_ha_ganado BOOLEAN,
    p_jugador_nombre TEXT
)
RETURNS JSONB
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
    v_partida RECORD;
    v_num_jugadores INT;
    v_siguiente_turno INT;
    v_nuevo_estado TEXT;
    v_nuevo_ganador TEXT;
    v_hay_espacio BOOLEAN;
BEGIN
    -- Bloquear la fila de la partida durante el procesamiento
    SELECT * INTO v_partida FROM public.partidas WHERE id = p_partida_id FOR UPDATE;

    IF NOT FOUND THEN
        RETURN jsonb_build_object('ok', false, 'message', 'La partida no existe.');
    END IF;

    IF v_partida.estado <> 'jugando' THEN
        RETURN jsonb_build_object('ok', false, 'message', 'La partida no está activa.');
    END IF;

    -- Validar que el jugador correspondiente esté ejecutando el turno
    v_num_jugadores := jsonb_array_length(v_partida.jugadores);
    IF (v_partida.jugadores->v_partida.turno_index->>'simbolo') <> p_simbolo THEN
        RETURN jsonb_build_object('ok', false, 'message', 'No es tu turno.');
    END IF;

    -- Evaluar resultado de la jugada
    v_nuevo_estado := 'jugando';
    v_nuevo_ganador := NULL;

    IF p_ha_ganado THEN
        v_nuevo_estado := 'finalizado';
        v_nuevo_ganador := p_jugador_nombre;
    ELSE
        -- Verificar si aún existen casillas vacías ("")
        SELECT EXISTS (
            SELECT 1 FROM jsonb_array_elements_text(p_nuevo_tablero) AS elem WHERE elem = ''
        ) INTO v_hay_espacio;

        IF NOT v_hay_espacio THEN
            v_nuevo_estado := 'finalizado';
            v_nuevo_ganador := 'Empate';
        ELSE
            -- Calcular siguiente turno en rotación
            v_siguiente_turno := (v_partida.turno_index + 1) % v_num_jugadores;
        END IF;
    END IF;

    IF v_nuevo_estado = 'finalizado' THEN
        v_siguiente_turno := v_partida.turno_index;
    END IF;

    -- Actualizar partida
    UPDATE public.partidas
    SET tablero = p_nuevo_tablero,
        turno_index = v_siguiente_turno,
        estado = v_nuevo_estado,
        ganador = v_nuevo_ganador
    WHERE id = p_partida_id;

    RETURN jsonb_build_object(
        'ok', true,
        'estado', v_nuevo_estado,
        'ganador', v_nuevo_ganador
    );
END;
$$;

-- Función 2: Reiniciar la tabla de posiciones desde el panel de administración
CREATE OR REPLACE FUNCTION public.reiniciar_ranking_admin()
RETURNS VOID
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
BEGIN
    TRUNCATE TABLE public.jugadores_stats;
END;
$$;